---
// Jedna podstrona usług wdrożeniowych zamiast trzech (Meta Power Up, Google
// Power Up, Automatyzacje VPS). Stare adresy przekierowują tu przez
// `redirects` w astro.config.mjs. Oferta jest wyceniana indywidualnie i ma
// próg wejścia (budżet reklamowy), więc strona najpierw mówi, dla kogo jest,
// a dopiero potem prosi o kontakt.
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import serwer from '../../assets/premium/wlasny-serwer.png';
import pomiar from '../../assets/premium/pomiar-serwer.png';
import automatyzacje from '../../assets/premium/automatyzacje.png';
import ai from '../../assets/integrator/mcp-claude.png';

export const prerender = true;

const filary = [
  {
    nr: '01',
    tag: 'Server-Side i GTM na własnym serwerze',
    title: 'Meta i Google dowiadują się o każdej konwersji',
    desc: 'Część zakupów i zgłoszeń nie dociera do platform reklamowych, bo przeglądarka albo blokada reklam zatrzymuje je po drodze. Na własnym serwerze informacja idzie prosto od Ciebie do Meta i Google.',
    points: [
      'Meta Conversions API, Google Tag Manager po stronie serwera i Google Analytics 4',
      'algorytmy uczą się na pełniejszych danych, więc lepiej dobierają odbiorców',
      'sam decydujesz, co i komu jest wysyłane, zgodnie ze zgodami użytkowników',
    ],
    img: pomiar,
    alt: 'Dane z okna przeglądarki omijają blokadę i trafiają przez własny serwer do dwóch platform',
  },
  {
    nr: '02',
    tag: 'Automatyzacje na własnym serwerze',
    title: 'Powtarzalna praca dzieje się sama',
    desc: 'Łączymy Twoje systemy: formularz, CRM, pocztę, sklep. Automatyzacje działają na Twoim serwerze, więc nie płacisz za każdą wykonaną operację, a dane klientów nie przechodzą przez kolejną firmę.',
    points: [
      'powiadomienie o nowym zgłoszeniu w kilka sekund',
      'zgłoszenie trafia do CRM bez przepisywania',
      'przypomnienia o porzuconym koszyku i wiadomości po zakupie',
    ],
    img: automatyzacje,
    alt: 'Serwer w środku pierścienia modułów: poczta, sklep, kalendarz, arkusz i wiadomości połączone liniami',
  },
  {
    nr: '03',
    tag: 'Integrator i AI',
    title: 'Twój własny Integrator zbiera wyniki kampanii',
    desc: 'Dopasowujemy go do Twoich preferencji: kont, CRM i sposobu raportowania. Oprócz Meta Ads i Google Ads możemy podłączyć TikTok Ads, Microsoft Ads, reklamy w ChatGPT i inne źródła, zależnie od potrzeb.',
    points: [
      'codzienny raport na e-mail albo Slacka',
      'rozmowa z AI o kampaniach (dziś Claude, ChatGPT wkrótce)',
      'przy każdej reklamie widać, ile przyniosła wartościowych zgłoszeń',
    ],
    img: ai,
    alt: 'Laptop z oknem rozmowy z AI połączony z kartami kampanii',
  },
];

const dlaCiebie = [
  'wydajesz na reklamy co najmniej 10 000 zł miesięcznie',
  'prowadzisz sklep albo zbierasz zgłoszenia i liczysz każdą konwersję',
  'chcesz mieć serwer i dane u siebie, a nie u kolejnego dostawcy',
  'wolisz jedno wdrożenie niż kilka osobnych abonamentów',
];

const nieDlaCiebie = [
  'Twój budżet reklamowy jest niższy niż 10 000 zł miesięcznie',
  'szukasz wtyczki, którą zainstalujesz samodzielnie w kwadrans',
  'nie masz jeszcze działających kampanii ani ruchu na stronie',
];

const kroki = [
  { title: 'Rozmowa', desc: '30 minut. Sprawdzamy, co dziś mierzysz i gdzie giną dane.' },
  { title: 'Wycena i plan', desc: 'Dostajesz zakres prac, cenę i termin. Bez zobowiązań.' },
  { title: 'Wdrożenie', desc: 'Stawiamy serwer i uruchamiamy wybrane elementy. Testujemy na żywych danych.' },
  { title: 'Przekazanie', desc: 'Dostajesz dostępy, hasła i opis tego, co działa. Serwer jest Twój.' },
];

const budzety = [
  { value: 'ponizej-10k', label: 'poniżej 10 000 zł' },
  { value: '10k-50k', label: '10 000 – 50 000 zł' },
  { value: 'powyzej-50k', label: 'powyżej 50 000 zł' },
];
---

<Layout
  dark
  title="Usługi Premium: własny serwer do pomiaru i automatyzacji | serwer-side.pl"
  description="Pomiar konwersji po stronie serwera, automatyzacje i Integrator z AI na Twoim własnym serwerze (VPS) w UE. Dla firm z budżetem reklamowym od 10 000 zł miesięcznie. Wycena indywidualna."
>
  {/* Hero */}
  <section class="bg-primary text-white py-16 md:py-20 overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="inline-block bg-accent/20 text-accent text-xs font-semibold px-3 py-1 rounded-full mb-5 uppercase tracking-wider">
            Usługi Premium (VPS)
          </span>
          <h1 class="text-3xl md:text-[2.75rem] font-extrabold leading-tight mb-5">
            Dedykowana infrastruktura analityczna i automatyzacje <span class="text-accent">na Twoim własnym serwerze</span>
          </h1>
          <p class="text-gray-300 text-lg mb-8">
            Stawiamy serwer (VPS), który należy do Ciebie, i uruchamiamy na nim pomiar konwersji, automatyzacje oraz Integratora z AI. Jedno wdrożenie zamiast kilku abonamentów.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="#wycena" class="inline-block text-center bg-accent hover:bg-accent-dark text-white font-semibold px-7 py-3.5 rounded-lg btn-brutal-light">
              Zapytaj o wycenę
            </a>
            <a href="#filary" class="inline-block text-center bg-white/5 hover:bg-white/10 text-white font-semibold px-7 py-3.5 rounded-lg btn-brutal-light">
              Zobacz, co wdrażamy
            </a>
          </div>
          <p class="text-gray-400 text-sm mt-4">Serwer w UE · Dostępy i hasła zostają u Ciebie · Wycena po rozmowie</p>
        </div>
        <div class="relative">
          <div class="absolute -inset-8 bg-accent/10 blur-3xl rounded-full pointer-events-none" aria-hidden="true"></div>
          <Image
            src={serwer}
            alt="Własny serwer na osobnej platformie, otoczony szklanym ogrodzeniem, z kluczem przy wejściu"
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 540px, 90vw"
            format="webp"
            loading="eager"
            class="relative w-full h-auto rounded-2xl"
          />
        </div>
      </div>
    </div>
  </section>

  {/* Trzy filary */}
  <section id="filary" class="py-16 md:py-20 scroll-mt-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-14">
        <span class="text-xs font-bold text-accent uppercase tracking-wider">Co wdrażamy</span>
        <h2 class="text-2xl md:text-3xl font-bold mt-3 mb-3">Trzy filary na jednym serwerze</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">Możesz zacząć od jednego i dołożyć kolejne później. Wszystko działa na tym samym serwerze.</p>
      </div>

      <div class="space-y-14 md:space-y-20">
        {filary.map((f, i) => (
          <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
            <div class:list={['bg-primary rounded-2xl overflow-hidden card-brutal-static', i % 2 === 1 && 'lg:order-last']}>
              <Image
                src={f.img}
                alt={f.alt}
                widths={[480, 720, 960]}
                sizes="(min-width: 1024px) 540px, 90vw"
                format="webp"
                loading="lazy"
                class="w-full h-auto"
              />
            </div>
            <div>
              <div class="flex items-center gap-3 mb-3">
                <span class="text-3xl font-extrabold text-accent leading-none">{f.nr}</span>
                <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">{f.tag}</span>
              </div>
              <h3 class="text-xl md:text-2xl font-bold mb-3">{f.title}</h3>
              <p class="text-gray-600 leading-relaxed mb-5">{f.desc}</p>
              <ul class="space-y-2.5 text-sm text-gray-700">
                {f.points.map((p) => (
                  <li class="flex items-start gap-2">
                    <span class="text-accent font-bold mt-0.5" aria-hidden="true">✓</span>
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Dla kogo */}
  <section class="py-16 md:py-20 bg-stone-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <h2 class="text-2xl md:text-3xl font-bold mb-3">Zanim napiszesz: sprawdź, czy to oferta dla Ciebie</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">Własny serwer zwraca się przy większych budżetach. Przy mniejszych lepiej zacząć od samego Integratora.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white rounded-xl p-7 card-brutal-accent">
          <h3 class="text-lg font-bold mb-4 text-primary">To JEST dla Ciebie, jeśli:</h3>
          <ul class="space-y-3 text-sm text-gray-700">
            {dlaCiebie.map((p) => (
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5" aria-hidden="true">✓</span>
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-white rounded-xl p-7 card-brutal-static">
          <h3 class="text-lg font-bold mb-4 text-primary">To NIE JEST dla Ciebie, jeśli:</h3>
          <ul class="space-y-3 text-sm text-gray-700">
            {nieDlaCiebie.map((p) => (
              <li class="flex items-start gap-3">
                <span class="w-5 h-5 rounded-full bg-red-100 text-red-700 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5" aria-hidden="true">✕</span>
                <span>{p}</span>
              </li>
            ))}
          </ul>
          <p class="mt-6 pt-5 border-t border-gray-200 text-sm text-gray-600">
            W takim przypadku wybierz <a href="/integrator/#cennik" class="text-accent font-semibold hover:underline">Integrator od 49 zł miesięcznie</a>. Podłączasz go sam, bez serwera.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Jak wygląda wdrożenie */}
  <section class="py-16 md:py-20 bg-primary text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl md:text-3xl font-bold text-center mb-12">Jak wygląda wdrożenie</h2>
      <ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {kroki.map((k, i) => (
          <li class="relative bg-white/5 border border-white/10 rounded-xl p-6">
            <span class="text-4xl font-extrabold text-accent/80 leading-none">{i + 1}</span>
            <h3 class="font-bold text-lg mt-3 mb-2">{k.title}</h3>
            <p class="text-sm text-gray-300 leading-relaxed">{k.desc}</p>
          </li>
        ))}
      </ol>
      <p class="text-center text-sm text-gray-400 mt-10 max-w-2xl mx-auto">
        Serwer stoi w Unii Europejskiej i jest zarejestrowany na Ciebie. Do Meta i Google trafia tylko to, na co pozwalają zgody Twoich użytkowników.
      </p>
    </div>
  </section>

  {/* Formularz */}
  <section id="wycena" class="py-16 md:py-20 scroll-mt-20">
    <div class="max-w-2xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <h2 class="text-2xl md:text-3xl font-bold mb-3">Zapytaj o wycenę</h2>
        <p class="text-gray-600">Odpowiadam w ciągu 24 godzin. Pierwsza rozmowa (30&nbsp;min) jest bezpłatna.</p>
      </div>
      <form id="premium-form" class="space-y-5 bg-white rounded-xl p-6 md:p-8 card-brutal-static">
        {/* Pułapka na boty: pole poza ekranem, człowiek go nie wypełni. api/contact.ts udaje sukces i nic nie wysyła. */}
        <div aria-hidden="true" class="absolute -left-[9999px] w-px h-px overflow-hidden">
          <label for="website_hp">Nie wypełniaj tego pola</label>
          <input type="text" id="website_hp" name="website_hp" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" name="service" value="infrastruktura-premium" />
        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Imię *</label>
            <input type="text" id="name" name="name" required placeholder="Jan"
              class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-accent focus:ring-2 focus:ring-accent/20 outline-none transition-colors" />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email *</label>
            <input type="email" id="email" name="email" required placeholder="jan@firma.pl"
              class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-accent focus:ring-2 focus:ring-accent/20 outline-none transition-colors" />
          </div>
        </div>
        <fieldset>
          <legend class="block text-sm font-medium text-gray-700 mb-2">Miesięczny budżet reklamowy *</legend>
          <div class="grid sm:grid-cols-3 gap-2">
            {budzety.map((b) => (
              <label class="flex items-center gap-3 px-4 py-3 border border-gray-300 rounded-lg bg-white cursor-pointer hover:border-accent has-[:checked]:border-accent has-[:checked]:bg-accent/5 transition-colors">
                <input type="radio" name="budget" value={b.label} required class="w-4 h-4 text-accent border-gray-300 focus:ring-accent" />
                <span class="text-sm text-gray-700">{b.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <div>
          <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Czego potrzebujesz? *</label>
          <textarea id="message" name="message" rows="4" required
            placeholder="Np. adres strony, z jakich platform reklamowych korzystasz i co chcesz poprawić"
            class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-accent focus:ring-2 focus:ring-accent/20 outline-none transition-colors resize-y"></textarea>
        </div>
        <div class="flex items-start gap-3">
          <input type="checkbox" id="rodo" name="rodo" required class="mt-1 w-4 h-4 text-accent border-gray-300 rounded focus:ring-accent" />
          <label for="rodo" class="text-xs text-gray-500 leading-relaxed">
            Zapoznałem się z&nbsp;<a href="/polityka-prywatnosci" target="_blank" class="text-accent hover:underline">Polityką prywatności</a>
            i&nbsp;chcę, żeby serwer-side.pl odpowiedział na moje zapytanie. *
          </label>
        </div>
        <p class="text-xs text-gray-400 leading-relaxed -mt-2">
          Administratorem danych jest Mateusz Ławiak, ul. Święty Marcin 29 lok. 8, 61-806 Poznań.
          Dane z&nbsp;formularza wykorzystamy wyłącznie do odpowiedzi i&nbsp;przygotowania oferty,
          a&nbsp;korespondencję przechowujemy 12 miesięcy. Masz prawo dostępu do danych, ich poprawienia
          i&nbsp;usunięcia. Szczegóły w&nbsp;<a href="/polityka-prywatnosci" class="underline hover:text-accent">Polityce prywatności</a>.
        </p>
        <button type="submit" class="w-full bg-accent hover:bg-accent-dark text-white font-semibold py-4 rounded-lg text-lg btn-brutal">
          Wyślij zapytanie
        </button>
        <div id="form-error" class="hidden p-4 bg-red-50 border-2 border-red-200 rounded-xl text-red-700 text-sm text-center">
          Nie udało się wysłać wiadomości. Spróbuj ponownie albo napisz bezpośrednio na
          <a href="mailto:kontakt@serwer-side.pl" class="font-semibold underline">kontakt@serwer-side.pl</a>.
        </div>
      </form>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('premium-form') as HTMLFormElement;
  const errorMsg = document.getElementById('form-error')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg.classList.add('hidden');
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      if (res.ok) window.location.href = '/wiadomosc-wyslana';
      else errorMsg.classList.remove('hidden');
    } catch {
      errorMsg.classList.remove('hidden');
    }
  });
</script>
