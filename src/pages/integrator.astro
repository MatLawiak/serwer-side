---
// Strona produktu Integrator. Jest też „stroną główną aplikacji” w ekranie
// zgody Google (projekt „Raporty”): recenzent szuka tu opisu aplikacji,
// sposobu użycia danych Google i linku do polityki prywatności. Sekcja
// zgodności (DataUse) musi zostać i mówić prawdę o tym, co robi panel.
// Język: dla właściciela agencji, nie dla programisty.
import Layout from '../layouts/Layout.astro';
import DigestPreview from '../components/integrator/DigestPreview.astro';
import FeatureGrid from '../components/integrator/FeatureGrid.astro';
import PricingCards from '../components/integrator/PricingCards';
import DataUse from '../components/integrator/DataUse.astro';
import { features, plans, PANEL_URL, TRIAL_URL } from '../data/integrator';

export const prerender = true;

const kroki = [
  {
    nr: '1',
    title: 'Podłączasz konta reklamowe',
    text: 'Logujesz się przez Facebook i Google i zaznaczasz konta, które Integrator ma czytać. Zajmuje to kilka minut, a pierwsze konto podłączymy razem.',
  },
  {
    nr: '2',
    title: 'Rano dostajesz raport',
    text: 'Na e-mail albo na Slacka. Krótko: co działa, co wymaga uwagi i co warto dziś zrobić u każdego klienta.',
  },
  {
    nr: '3',
    title: 'Decydujesz, co dalej',
    text: 'W panelu widzisz kampanie i reklamy z obu platform obok siebie. Możesz też zapytać o nie swoje narzędzie AI.',
  },
];

const faq = [
  {
    q: 'Co dokładnie jest w codziennym raporcie?',
    a: 'Dla każdego klienta najwyżej trzy najważniejsze wnioski i jedna podpowiedź, co zrobić. Na przykład: która kampania przynosi najtańsze zgłoszenia, która reklama przestała działać, gdzie warto przesunąć budżet. Jeśli wszystko jest w porządku, raport mówi to jednym zdaniem.',
  },
  {
    q: 'Czy muszę znać się na technice, żeby to podłączyć?',
    a: 'Nie. Logujesz się przez Facebook i Google, zaznaczasz konta i gotowe. Niczego nie instalujesz na stronie. Pierwsze konto podłączymy razem podczas krótkiej rozmowy.',
  },
  {
    q: 'Jak działa 7-dniowy okres próbny?',
    a: 'Zostawiasz kontakt w formularzu, a w ciągu jednego dnia roboczego zakładamy Ci konto. Przez 7 dni korzystasz bez opłat i bez podawania karty.',
  },
  {
    q: 'Z jakimi narzędziami AI to działa?',
    a: 'Dziś z Claude (aplikacja Claude Desktop i Claude Code). Obsługa ChatGPT jest w przygotowaniu. Podłączenie to wklejenie jednego klucza, który dostajesz w panelu i który możesz w każdej chwili wyłączyć.',
  },
  {
    q: 'Czy Integrator może coś zmienić w moich kampaniach?',
    a: 'Sam z siebie nie. Integrator tylko czyta dane. Zmiany na Twoje polecenie wydane przez AI (podniesienie budżetu, wstrzymanie kampanii) uruchomimy, gdy Meta i Google zatwierdzą aplikację. Nawet wtedy AI podniesie budżet najwyżej o 20% dziennie i nigdy samo nie włączy kampanii.',
  },
  {
    q: 'Na czym polega ocena leadów?',
    a: 'To opcja dla firm, które zbierają zgłoszenia. Handlowiec oznacza w arkuszu Google albo w CRM, które zgłoszenia były wartościowe, a Integrator pokazuje, z których reklam przyszły. Nie musisz jej włączać, raporty i rekomendacje działają bez niej.',
  },
  {
    q: 'Gdzie są przechowywane dane?',
    a: 'W Unii Europejskiej: baza danych w Irlandii, serwer aplikacji w Niemczech. Dane są szyfrowane, a dane kontaktowe ze zgłoszeń usuwamy automatycznie po 180 dniach.',
  },
];
---

<Layout
  title="Integrator danych reklamowych: Meta Ads i Google Ads w jednym panelu | serwer-side.pl"
  description="Wyniki kampanii Meta Ads i Google Ads w jednym panelu, codzienny raport na e-mail albo Slacka i proste podpowiedzi, co zmienić. Podłącz swoje narzędzie AI. 7 dni za darmo."
>
  {/* Hero */}
  <section class="bg-primary text-white py-16 md:py-20 overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="inline-block bg-accent/20 text-accent text-xs font-semibold px-3 py-1 rounded-full mb-5 uppercase tracking-wider">
            Integrator danych reklamowych
          </span>
          <h1 class="text-3xl md:text-5xl font-extrabold leading-tight mb-5">
            Meta Ads i Google Ads w jednym panelu. <span class="text-accent">Co rano wiesz, co zmienić.</span>
          </h1>
          <p class="text-gray-300 text-lg md:text-xl mb-8">
            Integrator zbiera wyniki kampanii z obu platform i codziennie wysyła Ci krótki raport z prostymi podpowiedziami: które kampanie wspierać, a które wstrzymać.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href={TRIAL_URL} class="inline-block text-center bg-accent hover:bg-accent-dark text-white font-semibold px-7 py-3.5 rounded-lg btn-brutal-light">
              Wypróbuj 7 dni za darmo
            </a>
            <a href={PANEL_URL} class="inline-block text-center bg-white/5 hover:bg-white/10 text-white font-semibold px-7 py-3.5 rounded-lg btn-brutal-light">
              Zaloguj się do panelu
            </a>
          </div>
          <p class="text-gray-400 text-sm mt-4">Bez karty · Pierwsze konto podłączymy razem · Dane w UE</p>
        </div>
        <div class="relative">
          <div class="absolute -inset-8 bg-accent/10 blur-3xl rounded-full pointer-events-none" aria-hidden="true"></div>
          <DigestPreview class="relative" />
        </div>
      </div>
    </div>
  </section>

  {/* Jak to działa */}
  <section class="py-16 md:py-20 bg-stone-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl md:text-3xl font-bold mb-3">Jak to działa</h2>
      <p class="text-gray-600 mb-10 max-w-2xl">Pierwszy raport dostajesz następnego ranka po podłączeniu konta.</p>
      <ol class="grid md:grid-cols-3 gap-6">
        {kroki.map((k) => (
          <li class="bg-white rounded-xl p-6 card-brutal-static">
            <span class="inline-flex w-9 h-9 items-center justify-center rounded-full bg-primary text-white font-bold mb-4">{k.nr}</span>
            <h3 class="text-lg font-bold mb-2">{k.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{k.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* Funkcje */}
  <section class="py-16 md:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl md:text-3xl font-bold mb-3">Co dostajesz</h2>
      <p class="text-gray-600 mb-10 max-w-2xl">Mniej czasu w Menedżerach reklam, więcej pewności, że budżet idzie tam, gdzie działa.</p>
      <FeatureGrid items={features} />

      {/* Opcja dodatkowa: ocena leadów */}
      <div class="mt-8 bg-stone-50 rounded-xl p-6 md:p-8 card-brutal-static grid md:grid-cols-3 gap-6 items-center">
        <div class="md:col-span-2">
          <span class="inline-block bg-accent/10 text-accent-dark text-xs font-semibold px-3 py-1 rounded-full mb-3">Opcja dodatkowa</span>
          <h3 class="text-xl font-bold mb-2">Zbierasz zgłoszenia? Sprawdź, które reklamy przynoszą dobrych klientów</h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            Handlowiec oznacza w arkuszu Google albo w CRM, które zgłoszenia były wartościowe. Integrator pokazuje wtedy, z których reklam przyszły, i odróżnia reklamę z dobrymi klientami od reklamy z tanimi, ale przypadkowymi kontaktami. Włączasz, jeśli chcesz. Bez tej opcji wszystko inne działa tak samo.
          </p>
        </div>
        <ul class="text-sm text-gray-700 space-y-2">
          <li class="flex items-start gap-2"><span class="text-accent font-bold mt-0.5">✓</span><span>arkusz Google albo CRM</span></li>
          <li class="flex items-start gap-2"><span class="text-accent font-bold mt-0.5">✓</span><span>zgłoszenia z formularzy Meta, Google i strony</span></li>
          <li class="flex items-start gap-2"><span class="text-accent font-bold mt-0.5">✓</span><span>dostępna w każdym planie</span></li>
        </ul>
      </div>
    </div>
  </section>

  {/* Dane Google i Meta: sekcja dla użytkowników i recenzentów platform */}
  <DataUse />

  {/* Cennik */}
  <section id="cennik" class="py-16 md:py-20 scroll-mt-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <h2 class="text-2xl md:text-3xl font-bold mb-3">Cennik</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">Każdy plan zaczyna się od 7 dni za darmo. Płacisz miesięcznie, rezygnujesz w dowolnej chwili.</p>
      </div>
      <PricingCards client:visible plans={plans} />
      <p class="text-center text-sm text-gray-500 mt-8">Plany różnią się liczbą klientów. Raporty, rekomendacje, podłączenie AI i ocena leadów są w każdym.</p>
    </div>
  </section>

  {/* FAQ */}
  <section class="py-16 md:py-20 bg-stone-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl md:text-3xl font-bold text-center mb-12">Najczęściej zadawane pytania</h2>
      <div class="space-y-4">
        {faq.map((item) => (
          <details class="group bg-white rounded-xl accordion-brutal overflow-hidden">
            <summary class="flex items-center justify-between p-5 cursor-pointer font-semibold text-primary hover:bg-stone-50 transition-colors">
              <span>{item.q}</span>
              <svg class="w-5 h-5 text-gray-400 transition-transform group-open:rotate-180 shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-5 pb-5 text-gray-600 text-sm leading-relaxed">{item.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="py-16 md:py-20 bg-primary text-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-2xl md:text-3xl font-bold mb-4">Zobacz jutro rano pierwszy raport ze swoich kampanii</h2>
      <p class="text-gray-300 mb-8">7 dni za darmo, bez karty. Pierwsze konto podłączymy razem.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={TRIAL_URL} class="inline-block bg-accent hover:bg-accent-dark text-white font-semibold px-8 py-4 rounded-lg text-lg btn-brutal-light">Wypróbuj 7 dni za darmo</a>
        <a href="/kontakt" class="inline-block bg-white/5 hover:bg-white/10 text-white font-semibold px-8 py-4 rounded-lg text-lg btn-brutal-light">Umów demo</a>
      </div>
    </div>
  </section>
</Layout>
