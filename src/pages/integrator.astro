---
// Strona produktu Integrator. Jest też „stroną główną aplikacji” w ekranie
// zgody Google (projekt „Raporty”): recenzent szuka tu opisu aplikacji,
// sposobu użycia danych Google i linku do polityki prywatności. Sekcja
// zgodności (DataUse) musi zostać i mówić prawdę o tym, co robi panel.
// Język: dla właściciela agencji, nie dla programisty.
import Layout from '../layouts/Layout.astro';
import DigestPreview from '../components/integrator/DigestPreview.astro';
import HeroReel from '../components/integrator/HeroReel.astro';
import FeatureTiles from '../components/integrator/FeatureTiles.astro';
import LeadQualityChart from '../components/integrator/LeadQualityChart.astro';
import IntegratorFlow from '../components/home/IntegratorFlow.astro';
import PricingTable from '../components/integrator/PricingTable.astro';
import DataUse from '../components/integrator/DataUse.astro';
import ForWhom from '../components/integrator/ForWhom.astro';
import DemoModal from '../components/integrator/DemoModal.astro';
import { PANEL_URL, SIGNUP_URL, CLIENT_DEFINITION, VAT_NOTE } from '../data/integrator';

export const prerender = true;

const faq = [
  {
    q: 'Co dokładnie jest w codziennym raporcie?',
    a: 'Dla każdego klienta najważniejsze wnioski i rekomendacje, co zrobić, oparte na danych ze wszystkich źródeł. Na przykład: która kampania przynosi najtańsze zgłoszenia, która reklama przestała działać, gdzie i na którą platformę warto przesunąć budżet. Jeśli wszystko jest w porządku, raport mówi to jednym zdaniem.',
  },
  {
    q: 'Czy muszę znać się na technice, żeby to podłączyć?',
    a: 'Nie. Logujesz się przez Facebook i Google, zaznaczasz konta i gotowe. Niczego nie instalujesz na stronie. Pierwsze konto podłączymy razem podczas krótkiej rozmowy.',
  },
  {
    q: 'Czy mogę sprawdzić Integrator bez opłaty?',
    a: 'Tak, z kodem promocyjnym. Kod z filmu albo od partnera wpisujesz przy zakładaniu konta i przez przypisaną do niego liczbę dni korzystasz bez opłat i bez karty. Bez kodu po założeniu konta wybierasz plan. Okres bez opłaty nie zamienia się sam w płatny plan.',
  },
  {
    q: 'Z jakimi narzędziami AI to działa?',
    a: 'Z Claude i z ChatGPT. Integrator dodajesz jako konektor, a dostęp zatwierdzasz logowaniem, bez kopiowania kluczy. Jedna zgoda w panelu obejmuje oba narzędzia, a połączenie wyłączysz w każdej chwili.',
  },
  {
    q: 'Czy Integrator może coś zmienić w moich kampaniach?',
    a: 'Sam z siebie nie. Zmiany wprowadza AI tylko na Twoje polecenie: podniesienie budżetu, wstrzymanie kampanii, nowa kampania. Nowa kampania zawsze powstaje wstrzymana, włączasz ją sam. AI podniesie budżet najwyżej o 20% dziennie i nigdy samo nie włączy kampanii.',
  },
  {
    q: 'Na czym polega ocena leadów?',
    a: 'To opcja dla firm, które zbierają zgłoszenia. Handlowiec oznacza w arkuszu Google (każdy plan) albo w CRM (plan Scale), które zgłoszenia były wartościowe, a Integrator pokazuje, z których reklam przyszły. Nie musisz jej włączać, raporty i rekomendacje działają bez niej.',
  },
  {
    q: 'Skąd mam wiedzieć o nowych funkcjach?',
    a: 'Nowości widzisz w panelu i dostajesz mailem. Lekcje o wykorzystaniu API w kampaniach, GTM i pracy z AI są w Akademii, w każdym planie.',
  },
  {
    q: 'Gdzie są przechowywane dane?',
    a: 'W Unii Europejskiej: baza danych w Irlandii, serwer aplikacji w Niemczech. Dane są szyfrowane, a dane kontaktowe ze zgłoszeń usuwamy automatycznie po 180 dniach.',
  },
];
---

<Layout
  dark
  title="Integrator danych reklamowych: Meta Ads i Google Ads w jednym panelu | serwer-side.pl"
  description="Wyniki kampanii Meta Ads i Google Ads w jednym panelu, codzienny raport na e-mail albo Slacka i proste podpowiedzi, co zmienić. Podłącz swoje narzędzie AI. Od 49 zł miesięcznie, Akademia w każdym planie."
>
  {/* Hero */}
  <section class="bg-primary text-white py-16 md:py-20 overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="inline-block bg-accent/20 text-accent text-xs font-semibold px-3 py-1 rounded-full mb-5 uppercase tracking-wider">
            Integrator danych reklamowych
          </span>
          <h1 class="text-3xl md:text-5xl font-extrabold leading-tight mb-5">
            Meta Ads i Google Ads w jednym panelu. <span class="text-accent">Co rano wiesz, co zmienić.</span>
          </h1>
          <p class="text-gray-300 text-lg md:text-xl mb-8">
            Integrator zbiera wyniki kampanii z Meta Ads i Google Ads i co rano wysyła Ci przejrzysty raport, bez „ulepszeń” podsuwanych przez platformy, które częściej podnoszą wydatki niż wyniki. Kampanie poprawiasz w rozmowie z Claude albo ChatGPT, a do Menedżera reklam zaglądasz rzadziej.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href={SIGNUP_URL} class="inline-block text-center bg-accent hover:bg-accent-dark text-white font-semibold px-7 py-3.5 rounded-lg btn-brutal-light">
              Załóż konto
            </a>
            <a href={PANEL_URL} class="inline-block text-center bg-white/5 hover:bg-white/10 text-white font-semibold px-7 py-3.5 rounded-lg btn-brutal-light">
              Zaloguj się do panelu
            </a>
          </div>
          <p class="text-gray-400 text-sm mt-4">Od 49 zł miesięcznie · Pierwsze konto podłączymy razem · Dane w UE</p>
          <a href="#dla-kogo" class="inline-flex items-center gap-1.5 mt-4 text-sm font-semibold text-accent hover:underline">
            Dla kogo jest Integrator?
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </a>
        </div>
        {/* Rolka zamiast podglądu raportu (2026-11-26); raport niżej, w sekcji „Codzienny raport” */}
        <HeroReel />
      </div>
    </div>
  </section>

  {/* Jak to działa: animowany schemat zamiast opisu krok po kroku */}
  <div class="bg-primary"><div class="max-w-6xl mx-auto px-4 sm:px-6"><hr class="border-white/10" /></div></div>
  <IntegratorFlow />

  {/* Dla kogo jest Integrator (cel odnośnika z hero) */}
  <ForWhom />

  {/* Co dostajesz: kafle z ilustracjami */}
  <section class="py-16 md:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl md:text-3xl font-bold mb-3">Co dostajesz</h2>
      <p class="text-gray-600 mb-10 max-w-2xl">Mniej czasu w Menedżerach reklam, więcej pewności, że budżet idzie tam, gdzie działa.</p>
      <FeatureTiles />

      {/* Opcja dodatkowa: ocena zgłoszeń */}
      <div class="mt-8 bg-stone-50 rounded-xl p-6 md:p-8 card-brutal-static grid md:grid-cols-2 gap-8 items-center">
        <div>
          <span class="inline-block bg-accent/10 text-accent-dark text-xs font-semibold px-3 py-1 rounded-full mb-3">W każdym planie</span>
          <h3 class="text-xl font-bold mb-2">Więcej zgłoszeń nie znaczy więcej klientów</h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            Handlowiec oznacza w arkuszu Google, a w planie Scale także w CRM, które zgłoszenia były wartościowe. Integrator pokazuje, z których reklam przyszły, i odsyła oceny do Mety. Włączasz, jeśli chcesz.
          </p>
        </div>
        <LeadQualityChart />
      </div>
    </div>
  </section>

  {/* Codzienny raport: podgląd przeniesiony z hero, gdy weszła tam rolka */}
  <section class="bg-primary text-white py-16 md:py-20 overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-2xl md:text-3xl font-bold mb-3">Codzienny raport</h2>
        <p class="text-gray-300 text-lg leading-relaxed">
          Integrator zbiera wyniki kampanii z obu platform i codziennie wysyła Ci krótki raport z prostymi podpowiedziami: które kampanie wspierać, a które wstrzymać.
        </p>
      </div>
      <div class="relative">
        <div class="absolute -inset-8 bg-accent/10 blur-3xl rounded-full pointer-events-none" aria-hidden="true"></div>
        <DigestPreview class="relative" />
      </div>
    </div>
  </section>

  {/* Dane Google i Meta: sekcja dla użytkowników i recenzentów platform */}
  <DataUse />

  {/* Cennik */}
  <section id="cennik" class="py-16 md:py-20 scroll-mt-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <h2 class="text-2xl md:text-3xl font-bold mb-3">Cennik</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">Płacisz miesięcznie, rezygnujesz w dowolnej chwili. Akademia Integratora jest w każdym planie.</p>
      </div>
      <PricingTable />
      <p class="text-center text-sm text-gray-500 mt-8 max-w-2xl mx-auto">{CLIENT_DEFINITION} Raporty, podpowiedzi i rozmowa z AI są w każdym planie, a ocena leadów od planu Agencja / Pro.</p>
      <p class="text-center text-xs text-gray-500 mt-3 max-w-2xl mx-auto">{VAT_NOTE}</p>
    </div>
  </section>

  {/* FAQ */}
  <section class="py-16 md:py-20 bg-stone-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl md:text-3xl font-bold text-center mb-12">Najczęściej zadawane pytania</h2>
      <div class="space-y-4">
        {faq.map((item) => (
          <details class="group bg-white rounded-xl accordion-brutal overflow-hidden">
            <summary class="flex items-center justify-between p-5 cursor-pointer font-semibold text-primary hover:bg-stone-50 transition-colors">
              <span>{item.q}</span>
              <svg class="w-5 h-5 text-gray-400 transition-transform group-open:rotate-180 shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-5 pb-5 text-gray-600 text-sm leading-relaxed">{item.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="py-16 md:py-20 bg-primary text-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-2xl md:text-3xl font-bold mb-4">Zobacz jutro rano pierwszy raport ze swoich kampanii</h2>
      <p class="text-gray-300 mb-8">Integrator i Akademia od 49 zł miesięcznie. Pierwsze konto podłączymy razem.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={SIGNUP_URL} class="inline-block bg-accent hover:bg-accent-dark text-white font-semibold px-8 py-4 rounded-lg text-lg btn-brutal-light">Załóż konto</a>
        <button type="button" data-demo-open aria-haspopup="dialog" class="inline-block bg-white/5 hover:bg-white/10 text-white font-semibold px-8 py-4 rounded-lg text-lg btn-brutal-light">Sprawdź, jak to wygląda</button>
      </div>
    </div>
  </section>
  <DemoModal />
</Layout>
