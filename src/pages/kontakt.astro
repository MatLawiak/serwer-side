---
import Layout from '../layouts/Layout.astro';

// Cztery opcje zamiast kilkunastu: formularz ma się dać wypełnić w pół minuty.
// Szczegóły (Meta czy Google, jaki serwer) ustalamy w rozmowie.
const opcje = [
  { id: 'integrator', label: 'Darmowy test Integratora (7 dni)' },
  { id: 'serverside-vps', label: 'Usługi Premium (własny serwer)' },
  { id: 'audyt', label: 'Audyt kont reklamowych' },
  { id: 'inne', label: 'Inne pytanie' },
];
---

<Layout
  dark
  title="Kontakt: test Integratora, usługi premium, audyt | serwer-side.pl"
  description="Zacznij 7-dniowy test Integratora, zapytaj o wdrożenie na własnym serwerze albo umów audyt kont reklamowych. Odpowiadam w ciągu 24 godzin."
>
  <section class="bg-primary text-white py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h1 class="text-3xl md:text-4xl font-extrabold mb-4">Porozmawiajmy o Twoich kampaniach</h1>
      <p class="text-gray-300 text-lg max-w-2xl mx-auto">
        Odpowiadam w ciągu 24 godzin. Pierwsza rozmowa (30&nbsp;min) jest bezpłatna.
      </p>
    </div>
  </section>

  <section class="py-16 md:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="grid md:grid-cols-5 gap-12">
        {/* Formularz */}
        <div class="md:col-span-3">
          <form id="contact-form" class="space-y-5">
            {/* Pułapka na boty: pole poza ekranem, człowiek go nie wypełni. api/contact.ts udaje sukces i nic nie wysyła. */}
            <div aria-hidden="true" class="absolute -left-[9999px] w-px h-px overflow-hidden">
              <label for="website_hp">Nie wypełniaj tego pola</label>
              <input type="text" id="website_hp" name="website_hp" tabindex="-1" autocomplete="off" />
            </div>
            <div>
              <label for="name" class="block text-sm font-medium text-gray-700 mb-1">
                Imię i nazwisko *
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-accent focus:ring-2 focus:ring-accent/20 outline-none transition-colors"
                placeholder="Jan Kowalski"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 mb-1">
                Email *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-accent focus:ring-2 focus:ring-accent/20 outline-none transition-colors"
                placeholder="jan@firma.pl"
              />
            </div>

            <fieldset>
              <legend class="block text-sm font-medium text-gray-700 mb-2">W czym mogę pomóc?</legend>
              <div class="grid sm:grid-cols-2 gap-2">
                {opcje.map((o) => (
                  <label class="flex items-center gap-3 px-4 py-3 border border-gray-300 rounded-lg bg-white cursor-pointer hover:border-accent has-[:checked]:border-accent has-[:checked]:bg-accent/5 transition-colors">
                    <input type="radio" id={o.id} name="service" value={o.id} checked={o.id === 'integrator'}
                      class="w-4 h-4 text-accent border-gray-300 focus:ring-accent" />
                    <span class="text-sm text-gray-700">{o.label}</span>
                  </label>
                ))}
              </div>
              {/* Plan z przycisku w cenniku (?plan=...). Trafia do maila razem z wyborem. */}
              <input type="hidden" id="plan" name="plan" value="" />
            </fieldset>

            <div>
              <label for="message" class="block text-sm font-medium text-gray-700 mb-1">
                Wiadomość <span class="text-gray-400 font-normal">(opcjonalnie)</span>
              </label>
              <textarea
                id="message"
                name="message"
                rows="3"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-accent focus:ring-2 focus:ring-accent/20 outline-none transition-colors resize-y"
                placeholder="Np. adres strony, cel kampanii albo pytanie, które chcesz zadać"
              ></textarea>
            </div>

            <div class="flex items-start gap-3">
              <input
                type="checkbox"
                id="rodo"
                name="rodo"
                required
                class="mt-1 w-4 h-4 text-accent border-gray-300 rounded focus:ring-accent"
              />
              <label for="rodo" class="text-xs text-gray-500 leading-relaxed">
                Zapoznałem się z&nbsp;<a href="/polityka-prywatnosci" target="_blank" class="text-accent hover:underline">Polityką prywatności</a>
                i&nbsp;chcę, żeby serwer-side.pl odpowiedział na moje zapytanie. *
              </label>
            </div>
            {/* Obowiązek informacyjny z art. 13 RODO. Podstawą jest odpowiedź na zapytanie (art. 6 ust. 1 lit. b),
                a nie zgoda: zgodę można wycofać, a odpowiedzi na wysłane pytanie nie da się cofnąć. */}
            <p class="text-xs text-gray-400 leading-relaxed -mt-2">
              Administratorem danych jest Mateusz Ławiak, ul. Święty Marcin 29 lok. 8, 61-806 Poznań.
              Dane z&nbsp;formularza wykorzystamy wyłącznie do odpowiedzi i&nbsp;przygotowania oferty,
              a&nbsp;korespondencję przechowujemy 12 miesięcy. Masz prawo dostępu do danych, ich poprawienia
              i&nbsp;usunięcia. Szczegóły w&nbsp;<a href="/polityka-prywatnosci" class="underline hover:text-accent">Polityce prywatności</a>.
            </p>

            <button
              type="submit"
              class="w-full bg-accent hover:bg-accent-dark text-white font-semibold py-4 rounded-lg text-lg btn-brutal"
            >
              Wyślij wiadomość
            </button>

            {/* Komunikaty */}
            <div id="form-success" class="hidden p-4 bg-green-50 border-2 border-green-200 rounded-xl text-green-700 text-sm text-center">
              Dziękuję, wiadomość dotarła. Odezwę się w ciągu 24 godzin.
            </div>
            <div id="form-error" class="hidden p-4 bg-red-50 border-2 border-red-200 rounded-xl text-red-700 text-sm text-center">
              Nie udało się wysłać wiadomości. Spróbuj ponownie albo napisz bezpośrednio na
              <a href="mailto:kontakt@serwer-side.pl" class="font-semibold underline">kontakt@serwer-side.pl</a>.
            </div>
          </form>
        </div>

        {/* Dane kontaktowe */}
        <div class="md:col-span-2">
          <div class="bg-primary text-white rounded-xl p-6 card-brutal-static mb-6">
            <h2 class="font-bold text-lg mb-3">Kto Ci odpisze</h2>
            <p class="text-sm text-gray-300 leading-relaxed mb-3">
              Mateusz Ławiak. Przez lata pracowałem w&nbsp;agencjach reklamowych i&nbsp;prowadziłem własny sklep internetowy.
            </p>
            <p class="text-sm text-gray-300 leading-relaxed mb-3">
              Wiem, co działa w&nbsp;kampaniach, i&nbsp;wiem, co frustruje marketerów oraz właścicieli firm: raporty, z&nbsp;których nic nie wynika, i&nbsp;budżet, który znika bez wyjaśnienia.
            </p>
            <p class="text-sm text-white font-semibold leading-relaxed">
              Napisz, jaki masz cel. Wspólnie ustalimy, jak do niego dojść.
            </p>
            <a href="/o-mnie" class="inline-block mt-4 text-sm text-accent font-semibold hover:underline">Więcej o mnie</a>
          </div>
          <div class="bg-stone-50 rounded-xl p-6 card-brutal-static">
            <h2 class="font-bold text-lg mb-4">Dane kontaktowe</h2>
            <div class="space-y-4 text-sm">
              <div>
                <p class="text-gray-500 mb-1">Email</p>
                <a href="mailto:kontakt@serwer-side.pl" class="text-accent hover:underline font-medium">
                  kontakt@serwer-side.pl
                </a>
              </div>
              <div>
                <p class="text-gray-500 mb-1">LinkedIn</p>
                <a
                  href="https://www.linkedin.com/in/mateuszlawiak/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-accent hover:underline font-medium"
                >
                  linkedin.com/in/mateuszlawiak
                </a>
              </div>
              <div>
                <p class="text-gray-500 mb-1">Facebook</p>
                <a
                  href="https://www.facebook.com/serwer.side/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-accent hover:underline font-medium"
                >
                  facebook.com/serwer.side
                </a>
              </div>
              <div>
                <p class="text-gray-500 mb-1">Instagram</p>
                <a
                  href="https://www.instagram.com/serwer.side/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-accent hover:underline font-medium"
                >
                  instagram.com/serwer.side
                </a>
              </div>
            </div>
            <hr class="my-6 border-gray-200" />
            <div class="text-sm text-gray-600 space-y-2">
              <p>Odpowiadam w ciągu <strong>24 godzin</strong></p>
              <p>Pierwsza rozmowa: <strong>30 min, bezpłatnie</strong></p>
              <p>Konto testowe Integratora zakładam w&nbsp;ciągu jednego dnia roboczego</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successMsg = document.getElementById('form-success')!;
  const errorMsg = document.getElementById('form-error')!;

  // Linki z innych stron (?usluga=integrator&plan=agencja, ?usluga=audyt)
  // zaznaczają odpowiednią opcję i przekazują plan do maila.
  const params = new URLSearchParams(window.location.search);
  const wybor = document.getElementById(params.get('usluga') || '') as HTMLInputElement | null;
  if (wybor && wybor.type === 'radio') wybor.checked = true;
  (document.getElementById('plan') as HTMLInputElement).value = params.get('plan') || '';

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    successMsg.classList.add('hidden');
    errorMsg.classList.add('hidden');

    const formData = new FormData(form);
    const data = Object.fromEntries(formData);
    data.service = formData.getAll('service').join(', ');

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        window.location.href = '/wiadomosc-wyslana';
      } else {
        errorMsg.classList.remove('hidden');
      }
    } catch {
      errorMsg.classList.remove('hidden');
    }
  });
</script>
