---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Kontakt — Umów bezpłatną diagnozę | serwer-side.pl"
  description="Skontaktuj się, aby umówić bezpłatną 30-minutową rozmowę diagnostyczną. Sprawdzimy, ile danych traci Twój tracking."
>
  <section class="bg-primary text-white py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h1 class="text-3xl md:text-4xl font-extrabold mb-4">Kontakt</h1>
      <p class="text-gray-300 text-lg">
        Odpowiadam w ciągu 24h. Pierwsza rozmowa diagnostyczna (30&nbsp;min) jest bezpłatna.
      </p>
    </div>
  </section>

  <section class="py-16 md:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="grid md:grid-cols-5 gap-12">
        {/* Formularz */}
        <div class="md:col-span-3">
          <form id="contact-form" class="space-y-5">
            {/* Pułapka na boty: pole poza ekranem, człowiek go nie wypełni. api/contact.ts udaje sukces i nic nie wysyła. */}
            <div aria-hidden="true" class="absolute -left-[9999px] w-px h-px overflow-hidden">
              <label for="website_hp">Nie wypełniaj tego pola</label>
              <input type="text" id="website_hp" name="website_hp" tabindex="-1" autocomplete="off" />
            </div>
            <div>
              <label for="name" class="block text-sm font-medium text-gray-700 mb-1">
                Imię i nazwisko *
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-accent focus:ring-2 focus:ring-accent/20 outline-none transition-colors"
                placeholder="Jan Kowalski"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 mb-1">
                Email *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-accent focus:ring-2 focus:ring-accent/20 outline-none transition-colors"
                placeholder="jan@firma.pl"
              />
            </div>

            <div>
              <label for="url" class="block text-sm font-medium text-gray-700 mb-1">
                URL strony / sklepu
              </label>
              <input
                type="url"
                id="url"
                name="url"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-accent focus:ring-2 focus:ring-accent/20 outline-none transition-colors"
                placeholder="https://mojsklep.pl"
              />
            </div>

            <div>
              <p class="block text-sm font-medium text-gray-700 mb-2">
                Czym mogę Ci pomóc? <span class="text-gray-400 font-normal">(wybierz jedną lub więcej)</span>
              </p>
              <div class="p-4 border border-gray-300 rounded-lg bg-white space-y-4">

                <div>
                  <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">Aplikacja</p>
                  <div class="space-y-2">
                    <div class="flex items-start gap-3">
                      <input type="checkbox" id="integrator" name="service" value="integrator"
                        class="mt-0.5 w-4 h-4 text-accent border-gray-300 rounded focus:ring-accent" />
                      <label for="integrator" class="text-sm text-gray-700 cursor-pointer">
                        Darmowy test Integratora (7 dni)
                      </label>
                    </div>
                    {/* Plan z przycisku w cenniku (?plan=...). Trafia do maila jako osobne pole usługi. */}
                    <select id="plan" name="plan" class="hidden ml-7 text-sm border border-gray-300 rounded-md px-2 py-1 text-gray-700">
                      <option value="starter">Plan Starter</option>
                      <option value="agencja">Plan Agencja</option>
                      <option value="enterprise">Plan Enterprise</option>
                    </select>
                  </div>
                </div>

                <div>
                  <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">Tracking reklamowy</p>
                  <div class="space-y-2">
                    <div class="flex items-start gap-3">
                      <input type="checkbox" id="serverside-vps" name="service" value="serverside-vps"
                        class="mt-0.5 w-4 h-4 text-accent border-gray-300 rounded focus:ring-accent" />
                      <label for="serverside-vps" class="text-sm text-gray-700 cursor-pointer">
                        Wdrożenie Server-Side / VPS (nie wiem jeszcze, Meta czy Google)
                      </label>
                    </div>
                    <div class="flex items-start gap-3">
                      <input type="checkbox" id="meta-power-vps" name="service" value="meta-power-vps"
                        class="mt-0.5 w-4 h-4 text-accent border-gray-300 rounded focus:ring-accent" />
                      <label for="meta-power-vps" class="text-sm text-gray-700 cursor-pointer">
                        Meta Power Up: Meta Pixel i CAPI na własnym serwerze
                      </label>
                    </div>
                    <div class="flex items-start gap-3">
                      <input type="checkbox" id="google-power-vps" name="service" value="google-power-vps"
                        class="mt-0.5 w-4 h-4 text-accent border-gray-300 rounded focus:ring-accent" />
                      <label for="google-power-vps" class="text-sm text-gray-700 cursor-pointer">
                        Google Power Up: GA4 i Google Ads server-side
                      </label>
                    </div>
                    <div class="flex items-start gap-3">
                      <input type="checkbox" id="meta-google-combo" name="service" value="meta-google-combo"
                        class="mt-0.5 w-4 h-4 text-accent border-gray-300 rounded focus:ring-accent" />
                      <label for="meta-google-combo" class="text-sm text-gray-700 cursor-pointer">
                        Meta i Google Power Up: oba kanały jednocześnie
                      </label>
                    </div>
                  </div>
                </div>

                <div>
                  <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">Automatyzacje</p>
                  <div class="space-y-2">
                    <div class="flex items-start gap-3">
                      <input type="checkbox" id="automatyzacje-vps" name="service" value="automatyzacje-vps"
                        class="mt-0.5 w-4 h-4 text-accent border-gray-300 rounded focus:ring-accent" />
                      <label for="automatyzacje-vps" class="text-sm text-gray-700 cursor-pointer">
                        Automatyzacje VPS: n8n, CRM, maile, integracje
                      </label>
                    </div>
                  </div>
                </div>

                <div>
                  <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">Inne</p>
                  <div class="space-y-2">
                    <div class="flex items-start gap-3">
                      <input type="checkbox" id="audyt" name="service" value="audyt"
                        class="mt-0.5 w-4 h-4 text-accent border-gray-300 rounded focus:ring-accent" />
                      <label for="audyt" class="text-sm text-gray-700 cursor-pointer">
                        Audyt kont reklamowych i ustawień Meta/Google
                      </label>
                    </div>
                    <div class="flex items-start gap-3">
                      <input type="checkbox" id="pixelyoursite" name="service" value="pixelyoursite"
                        class="mt-0.5 w-4 h-4 text-accent border-gray-300 rounded focus:ring-accent" />
                      <label for="pixelyoursite" class="text-sm text-gray-700 cursor-pointer">
                        Konfiguracja PixelYourSite z GTM i CookieYes
                      </label>
                    </div>
                    <div class="flex items-start gap-3">
                      <input type="checkbox" id="konsultacja" name="service" value="konsultacja"
                        class="mt-0.5 w-4 h-4 text-accent border-gray-300 rounded focus:ring-accent" />
                      <label for="konsultacja" class="text-sm text-gray-700 cursor-pointer">
                        Konsultacja / pytanie ogólne
                      </label>
                    </div>
                    <div class="flex items-start gap-3">
                      <input type="checkbox" id="inne" name="service" value="inne"
                        class="mt-0.5 w-4 h-4 text-accent border-gray-300 rounded focus:ring-accent" />
                      <label for="inne" class="text-sm text-gray-700 cursor-pointer">
                        Inne
                      </label>
                    </div>
                  </div>
                </div>

              </div>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-gray-700 mb-1">
                Wiadomość
              </label>
              <textarea
                id="message"
                name="message"
                rows="4"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-accent focus:ring-2 focus:ring-accent/20 outline-none transition-colors resize-y"
                placeholder="Opisz swoją sytuację lub zadaj pytanie..."
              ></textarea>
            </div>

            <div class="flex items-start gap-3">
              <input
                type="checkbox"
                id="rodo"
                name="rodo"
                required
                class="mt-1 w-4 h-4 text-accent border-gray-300 rounded focus:ring-accent"
              />
              <label for="rodo" class="text-xs text-gray-500 leading-relaxed">
                Zapoznałem się z&nbsp;<a href="/polityka-prywatnosci" target="_blank" class="text-accent hover:underline">Polityką prywatności</a>
                i&nbsp;chcę, żeby serwer-side.pl odpowiedział na moje zapytanie. *
              </label>
            </div>
            {/* Obowiązek informacyjny z art. 13 RODO. Podstawą jest odpowiedź na zapytanie (art. 6 ust. 1 lit. b),
                a nie zgoda: zgodę można wycofać, a odpowiedzi na wysłane pytanie nie da się cofnąć. */}
            <p class="text-xs text-gray-400 leading-relaxed -mt-2">
              Administratorem danych jest Mateusz Ławiak, ul. Święty Marcin 29 lok. 8, 61-806 Poznań.
              Dane z&nbsp;formularza wykorzystamy wyłącznie do odpowiedzi i&nbsp;przygotowania oferty,
              a&nbsp;korespondencję przechowujemy 12 miesięcy. Masz prawo dostępu do danych, ich poprawienia
              i&nbsp;usunięcia. Szczegóły w&nbsp;<a href="/polityka-prywatnosci" class="underline hover:text-accent">Polityce prywatności</a>.
            </p>

            <button
              type="submit"
              class="w-full bg-accent hover:bg-accent-dark text-white font-semibold py-4 rounded-lg text-lg btn-brutal"
            >
              Wyślij wiadomość
            </button>

            {/* Komunikaty */}
            <div id="form-success" class="hidden p-4 bg-green-50 border-2 border-green-200 rounded-xl text-green-700 text-sm text-center">
              Dziękuję! Twoja wiadomość została wysłana. Odezwę się w ciągu 24h.
            </div>
            <div id="form-error" class="hidden p-4 bg-red-50 border-2 border-red-200 rounded-xl text-red-700 text-sm text-center">
              Nie udało się wysłać wiadomości. Spróbuj ponownie albo napisz bezpośrednio na
              <a href="mailto:kontakt@serwer-side.pl" class="font-semibold underline">kontakt@serwer-side.pl</a>.
            </div>
          </form>
        </div>

        {/* Dane kontaktowe */}
        <div class="md:col-span-2">
          <div class="bg-stone-50 rounded-xl p-6 card-brutal-static">
            <h2 class="font-bold text-lg mb-4">Dane kontaktowe</h2>
            <div class="space-y-4 text-sm">
              <div>
                <p class="text-gray-500 mb-1">Email</p>
                <a href="mailto:kontakt@serwer-side.pl" class="text-accent hover:underline font-medium">
                  kontakt@serwer-side.pl
                </a>
              </div>
              <div>
                <p class="text-gray-500 mb-1">LinkedIn</p>
                <a
                  href="https://www.linkedin.com/in/mateuszlawiak/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-accent hover:underline font-medium"
                >
                  linkedin.com/in/mateuszlawiak
                </a>
              </div>
              <div>
                <p class="text-gray-500 mb-1">Facebook</p>
                <a
                  href="https://www.facebook.com/serwer.side/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-accent hover:underline font-medium"
                >
                  facebook.com/serwer.side
                </a>
              </div>
              <div>
                <p class="text-gray-500 mb-1">Instagram</p>
                <a
                  href="https://www.instagram.com/serwer.side/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-accent hover:underline font-medium"
                >
                  instagram.com/serwer.side
                </a>
              </div>
            </div>
            <hr class="my-6 border-gray-200" />
            <div class="text-sm text-gray-600 space-y-2">
              <p>Odpowiadam w ciągu <strong>24 godzin</strong></p>
              <p>Pierwsza rozmowa: <strong>30 min, bezpłatnie</strong></p>
              <p>Omówimy Twój obecny tracking i&nbsp;potencjał do poprawy</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successMsg = document.getElementById('form-success')!;
  const errorMsg = document.getElementById('form-error')!;

  // Przyciski „Wypróbuj 7 dni” z /integrator i /uslugi prowadzą tu z
  // ?usluga=integrator&plan=... : zaznaczamy usługę i pokazujemy wybrany plan.
  const params = new URLSearchParams(window.location.search);
  const integrator = document.getElementById('integrator') as HTMLInputElement;
  const plan = document.getElementById('plan') as HTMLSelectElement;
  const pokazPlan = () => plan.classList.toggle('hidden', !integrator.checked);
  // ?usluga=<id> zaznacza dowolną opcję formularza (integrator, audyt, serverside-vps...).
  const zaznacz = document.getElementById(params.get('usluga') || '') as HTMLInputElement | null;
  if (zaznacz && zaznacz.type === 'checkbox') zaznacz.checked = true;
  const wybranyPlan = params.get('plan');
  if (wybranyPlan && [...plan.options].some((o) => o.value === wybranyPlan)) plan.value = wybranyPlan;
  integrator.addEventListener('change', pokazPlan);
  pokazPlan();

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    successMsg.classList.add('hidden');
    errorMsg.classList.add('hidden');

    const formData = new FormData(form);
    const data = Object.fromEntries(formData);
    data.service = formData.getAll('service').join(', ');

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        window.location.href = '/wiadomosc-wyslana';
      } else {
        errorMsg.classList.remove('hidden');
      }
    } catch {
      errorMsg.classList.remove('hidden');
    }
  });
</script>
