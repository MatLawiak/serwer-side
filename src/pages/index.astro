---
// Strona główna: Integrator jako główny produkt, potem cennik, a usługi
// premium (własny serwer) dopiero na końcu, jako oferta dla większych budżetów. Dotychczasowe sekcje o utraconych konwersjach
// (HeroNew, DataFlowAnimated, BarriersSection) żyją dalej na
// /server-side-tracking, żeby nie stracić pozycji na te frazy.
import Layout from '../layouts/Layout.astro';
import HeroIntegrator from '../components/home/HeroIntegrator.astro';
import IntegratorFlow from '../components/home/IntegratorFlow.astro';
import UspCards from '../components/home/UspCards.astro';
import McpScene from '../components/home/McpScene.astro';
import PremiumTeaser from '../components/home/PremiumTeaser.astro';
import PricingTable from '../components/integrator/PricingTable.astro';
import CaseStudyAnon from '../components/CaseStudyAnon.astro';
import Testimonials from '../components/Testimonials.astro';
import DataUse from '../components/integrator/DataUse.astro';
import { TRIAL_URL, PREMIUM_URL, CLIENT_DEFINITION } from '../data/integrator';

// Statyczna strona: adapter Cloudflare optymalizuje obrazy (webp) tylko
// przy prerenderingu; na żądanie serwowałby 500 KB PNG z Gemini jak leci.
export const prerender = true;
---

<Layout
  title="Integrator: Meta Ads i Google Ads bez otwierania Menedżera reklam | serwer-side.pl"
  description="Wyniki kampanii Meta Ads i Google Ads w jednym panelu. Codzienny raport na e-mail albo Slacka z prostymi podpowiedziami, co zmienić. Podłącz swoje narzędzie AI. 7 dni za darmo."
>
  {/* 1. Hero: Integrator, liczniki, ilustracja źródeł danych */}
  <HeroIntegrator />

  <div class="bg-primary"><div class="max-w-6xl mx-auto px-4 sm:px-6"><hr class="border-white/10" /></div></div>

  {/* 2. Animowany schemat: źródła → Integrator → wyjścia */}
  <IntegratorFlow />

  {/* 3. Trzy wyróżniki z etykietami stanu */}
  <UspCards />

  {/* 4. Scena MCP: ilustracja + zapis rozmowy z Claude */}
  <McpScene />

  {/* 5. Cennik Integratora */}
  <section id="cennik" class="py-16 md:py-20 scroll-mt-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <span class="text-xs font-bold text-accent uppercase tracking-wider">Cennik</span>
        <h2 class="text-2xl md:text-3xl font-bold mt-3 mb-3">Prosty cennik, 7 dni za darmo</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">Płacisz miesięcznie i rezygnujesz w dowolnej chwili. Plan dobierasz do liczby klientów.</p>
      </div>
      <PricingTable />
      <p class="text-center text-sm text-gray-500 mt-8 max-w-2xl mx-auto">{CLIENT_DEFINITION}</p>
    </div>
  </section>

  {/* 6. Case study (anonimowe) z animowanymi wykresami */}
  <CaseStudyAnon />

  <div class="bg-primary"><div class="max-w-6xl mx-auto px-4 sm:px-6"><hr class="border-white/10" /></div></div>

  {/* 7. Testimoniale */}
  <Testimonials />

  {/* 8. Zgodność: dane z Google i Meta */}
  <DataUse dark />

  <div class="bg-primary"><div class="max-w-6xl mx-auto px-4 sm:px-6"><hr class="border-white/10" /></div></div>

  {/* 9. Usługi premium: własny serwer, na końcu */}
  <PremiumTeaser />

  <div class="bg-primary"><div class="max-w-6xl mx-auto px-4 sm:px-6"><hr class="border-white/10" /></div></div>

  {/* 10. CTA końcowe */}
  <section class="py-20 md:py-28 bg-primary text-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <span class="inline-block bg-accent/20 text-accent text-xs font-semibold px-3 py-1 rounded-full mb-6 uppercase tracking-wider">
        7 dni za darmo
      </span>
      <h2 class="text-2xl md:text-4xl font-extrabold mb-5 leading-tight">
        Jutro rano pierwszy raport<br/>
        z Twoich kampanii.
      </h2>
      <p class="text-gray-300 mb-3 text-lg max-w-xl mx-auto">
        7 dni za darmo, bez karty. Pierwsze konto podłączymy razem.
      </p>
      <p class="text-gray-500 text-sm mb-10 max-w-lg mx-auto">
        Nie wiesz, czy Twoje kampanie dostają pełne dane? Zacznij od bezpłatnej rozmowy, sprawdzimy to razem.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={TRIAL_URL} class="inline-block bg-accent hover:bg-accent-dark text-white font-semibold px-10 py-4 rounded-lg text-lg btn-brutal-light">
          Wypróbuj Integrator
        </a>
        <a href="/kontakt?usluga=audyt" class="inline-block bg-transparent border-2 border-white/30 hover:border-accent hover:text-accent text-white font-semibold px-10 py-4 rounded-lg text-lg transition-colors">
          Umów bezpłatną rozmowę
        </a>
      </div>
      <p class="text-xs text-gray-600 mt-4">Odpowiadam w 24 h.</p>

      <div class="mt-10 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
        <a href="/integrator" class="text-gray-400 hover:text-accent transition-colors">Integrator w szczegółach</a>
        <span class="text-white/20">|</span>
        <a href={PREMIUM_URL} class="text-gray-400 hover:text-accent transition-colors">Usługi Premium (VPS)</a>
        <span class="text-white/20">|</span>
        <a href="/server-side-tracking" class="text-gray-400 hover:text-accent transition-colors">Czym jest server-side tracking</a>
        <span class="text-white/20">|</span>
        <a href="/wiedza" class="text-gray-400 hover:text-accent transition-colors">Baza wiedzy</a>
      </div>
    </div>
  </section>
</Layout>
