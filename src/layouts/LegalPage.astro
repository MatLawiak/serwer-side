---
// Układ dokumentów prawnych (polityka prywatności, regulamin).
// Strony są w MDX, żeby tekst dało się poprawiać bez dotykania znaczników;
// Meta i Google sprawdzają te adresy przy weryfikacji aplikacji.
import Layout from './Layout.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    updated: string;
  };
}

const { title, description, updated } = Astro.props.frontmatter;
---

<Layout title={`${title} | serwer-side.pl`} description={description}>
  <article class="py-12 md:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <header class="mb-10">
        <p class="text-sm text-gray-500 mb-3">Obowiązuje od {updated}</p>
        <h1 class="text-3xl md:text-4xl font-extrabold leading-tight">{title}</h1>
      </header>
      <div class="prose prose-lg max-w-none prose-headings:text-primary prose-headings:scroll-mt-24 prose-a:text-accent prose-a:no-underline hover:prose-a:underline prose-strong:text-primary">
        <slot />
      </div>
    </div>
  </article>
</Layout>
