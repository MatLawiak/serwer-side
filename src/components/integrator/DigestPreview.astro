---
// Podgląd codziennego raportu, który Integrator wysyła na Slacka i e-mail.
// Zastąpił makietę panelu: panel się zmienia, a raport (trzy wnioski i jedna
// akcja na klienta, kolorowa kropka priorytetu) ma właśnie taki układ.
// Nazwy klientów i liczby są przykładowe, stąd podpis.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const klienci = [
  {
    dot: 'bg-amber-400',
    name: 'Zielone Tarasy',
    note: 'do przejrzenia',
    points: [
      'Meta Ads: kampania „Mieszkania z ogrodem” przynosi zgłoszenia o jedną trzecią taniej niż Twoja średnia.',
      'Google Ads: reklama „Rabat 5%” wydaje coraz więcej, a zgłoszeń nie przybywa.',
    ],
    action: 'Przesuń część budżetu z „Rabat 5%” na „Mieszkania z ogrodem”.',
  },
  {
    dot: 'bg-emerald-400',
    name: 'Sklep Aurora',
    note: 'stabilnie',
    points: ['Wszystkie kampanie działają stabilnie, nic nie wymaga reakcji.'],
    action: '',
  },
];
---

<figure class={`relative ${className}`} aria-label="Przykład codziennego raportu wysyłanego przez Integrator">
  <div class="rounded-2xl bg-[#0f172a] border border-white/10 overflow-hidden text-left text-sm shadow-2xl shadow-black/30">
    <div class="flex items-center gap-3 px-4 py-3 border-b border-white/10">
      <img src="/robot-mascot-nobg.png" alt="" class="w-8 h-8 object-contain rounded-md bg-white/5" loading="lazy" />
      <div class="leading-tight">
        <p class="font-semibold text-white">Integrator <span class="text-[10px] font-medium text-gray-400 border border-white/15 rounded px-1 ml-1">APP</span></p>
        <p class="text-xs text-gray-400">dziś, 7:00 · #kampanie</p>
      </div>
    </div>
    <div class="p-4 space-y-4">
      <p class="font-bold text-white flex items-center gap-2">
        <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6m4 6V5m4 14v-9M5 19h14" /></svg>
        Codzienny raport kampanii
      </p>
      {klienci.map((k) => (
        <div class="border-l-2 border-white/15 pl-3">
          <p class="flex items-center gap-2 font-semibold text-white">
            <span class={`w-2.5 h-2.5 rounded-full ${k.dot}`}></span>
            {k.name}
            <span class="text-xs font-normal text-gray-400">{k.note}</span>
          </p>
          <ul class="mt-1.5 space-y-1.5 text-gray-300">
            {k.points.map((p) => <li class="flex gap-2"><span class="text-gray-500">•</span><span>{p}</span></li>)}
          </ul>
          {k.action && (
            <p class="mt-2 text-gray-100 flex gap-2">
              <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
              <span><strong>Co zrobić:</strong> {k.action}</span>
            </p>
          )}
        </div>
      ))}
    </div>
  </div>
  <figcaption class="mt-2 text-xs text-gray-400 text-center">Przykładowy raport na Slacku. Ten sam przychodzi e-mailem.</figcaption>
</figure>
