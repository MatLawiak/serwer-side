---
// „Co dostajesz”: sześć kafli, infografika (Remotion, 2026-11-26), tytuł
// i jedno zdanie. Bez tekstu na obrazie, podpisy w HTML. Kafel raportu to
// pętla wideo, reszta obrazy WebP (InfoMedia.astro).
import InfoMedia from './InfoMedia.astro';

const kafle = [
  {
    name: '04-panel',
    alt: 'Ekran panelu Integratora: podsumowanie klienta i lista rzeczy do zrobienia',
    title: 'Przejrzysty panel',
    text: 'Wydatki, wyniki i zadania na dziś z Meta i Google w jednym widoku.',
  },
  {
    name: '05-raport',
    video: true,
    alt: 'Raport o 7:00 na telefonie i wiadomość na Slacku',
    title: 'Codzienny raport',
    text: 'Co rano na e-mail albo Slacka: co działa, co przepala budżet i co zrobić dziś.',
  },
  {
    name: '06-podpowiedzi',
    alt: 'Przekreślone zalecenia platform reklamowych obok konkretnych ruchów z wyników Twoich kampanii',
    title: 'Podpowiedzi z Twoich danych',
    text: 'Z wyników Twoich kampanii, nie z zaleceń platformy, która zarabia na Twoim budżecie.',
  },
  {
    name: '07-rozmowa-ai',
    alt: 'Rozmowa w czacie AI kończy się wstrzymaniem kampanii',
    title: 'Rozmowa z Twoim AI',
    text: 'Pytasz o kampanie zwykłymi zdaniami i zlecasz zmiany w Claude albo ChatGPT.',
  },
  {
    name: '08-dane-pod-kluczem',
    alt: 'Kłódka w kręgu gwiazd UE i osobne, zamknięte szuflady klientów',
    title: 'Dane pod kluczem',
    text: 'Każdy klient osobno, dane szyfrowane, serwery w Unii Europejskiej.',
  },
  {
    name: '09-akademia',
    alt: 'Lekcje Akademii i koperta z nowościami API',
    title: 'Akademia i nowości API',
    text: 'Aktualnie 14 lekcji o wykorzystaniu API w kampaniach, GTM i pracy z AI. O nowościach piszemy klientom mailem i w panelu.',
  },
];
---

<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5" id="feature-tiles">
  {kafle.map((k, i) => (
    <div
      class="tile bg-primary text-white rounded-2xl overflow-hidden card-brutal-static flex flex-col opacity-0 translate-y-4 transition-all duration-500"
      style={`transition-delay: ${i * 90}ms`}
    >
      <div class="aspect-[16/10] overflow-hidden bg-[#1a2744]">
        <InfoMedia name={k.name} alt={k.alt} video={k.video} class="h-full object-cover" />
      </div>
      <div class="p-5">
        <h3 class="text-lg font-bold">{k.title}</h3>
        <p class="text-sm text-gray-300 mt-1">{k.text}</p>
      </div>
    </div>
  ))}
</div>

<noscript><style>#feature-tiles .tile { opacity: 1 !important; transform: none !important; }</style></noscript>

<script>
  const tiles = document.getElementById('feature-tiles');
  if (tiles) {
    const cards = tiles.querySelectorAll<HTMLElement>('.tile');
    const show = () => cards.forEach((c) => c.classList.remove('opacity-0', 'translate-y-4'));
    const observer = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        show();
        observer.disconnect();
      }
    }, { threshold: 0.05 });
    observer.observe(tiles);
  }
</script>
