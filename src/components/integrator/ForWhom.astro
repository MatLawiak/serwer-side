---
// Sekcja #dla-kogo: dwie karty z konkretnymi wskazaniami dla dwóch grup
// odbiorców, każda z infografiką u góry (Remotion, 2026-11-26). Bez fikcyjnych
// historii. Każde zdanie opisuje funkcję, która działa w aplikacji (stan kodu
// integratora 2026-11-26: Claude i ChatGPT, arkusz ocen i Conversions API
// w każdym planie, CRM w Scale). Na stronie głównej pod kartami jest link do
// /integrator (`showMore`).
import InfoMedia from './InfoMedia.astro';

interface Props {
  showMore?: boolean;
}
const { showMore = false } = Astro.props;

const grupy = [
  {
    media: { name: '02-dla-kogo-wlasna-firma', alt: 'Właściciel firmy między sklepem internetowym a firmą B2B: sprzedaż rośnie, leady mają ocenę' },
    title: 'Prowadzisz własną firmę',
    lead: 'Sprzedajesz w sklepie internetowym albo zbierasz zapytania w B2B? To narzędzie jest dla Ciebie.',
    points: [
      'Sklep: sprzedaż, przychód i ROAS z Meta i Google obok siebie.',
      'B2B: koszt leada i kampanie, które dają zgłoszenia najtaniej.',
      'Co rano krótki raport: co działa, a co przepala budżet.',
      'Kampanię przygotujesz w rozmowie z Claude albo ChatGPT, a następnie włączasz ją ręcznie w Menedżerze reklam, żeby zachować kontrolę nad tym, co tworzysz. Ogromna oszczędność czasu: skup się na ulepszaniu kreacji, a kwestie techniczne zostaw Integratorowi.',
      'Audyt GTM pokaże, czy zakupy i zgłoszenia ze strony są poprawnie mierzone.',
    ],
    plan: 'Plan Starter: 1 klient, 49 zł netto miesięcznie, Akademia w cenie.',
  },
  {
    media: { name: '03-dla-kogo-agencja', alt: 'Freelancer z laptopem prowadzi wielu klientów naraz i wydaje polecenia w czacie AI' },
    title: 'Prowadzisz agencję albo jesteś freelancerem?',
    lead: 'Kontrolujesz 10, 20, 30 i więcej klientów z jednego miejsca.',
    points: [
      'Kampaniami zarządzasz poleceniami w Claude albo ChatGPT.',
      'Wyniki wszystkich klientów sprawdzasz i porównujesz w jednym panelu. Każdy ma osobne konta i dostęp.',
      'Raport poranny wskazuje konta, które dziś wymagają uwagi.',
      'Handlowiec ocenia leady w arkuszu Google, a w planie Scale w CRM. Oceny wracają do Mety przez Conversions API.',
      'Konwersje, piksele i tagi GTM nowego klienta ustawisz z czatu, bez ręcznego przeglądania kontenera.',
    ],
    plan: 'Plan Agencja / Pro: do 10 klientów i 3 osób. Scale: do 50 klientów i 10 osób. Więcej według ustaleń.',
  },
];
---

<section id="dla-kogo" class="py-16 md:py-20 scroll-mt-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-12">
      <span class="text-xs font-bold text-accent uppercase tracking-wider">Dla kogo</span>
      <h2 class="text-2xl md:text-3xl font-bold mt-3 mb-3">Dla kogo jest Integrator?</h2>
      <p class="text-gray-600 max-w-2xl mx-auto">Dla firm, które reklamują się same, i dla tych, którzy prowadzą kampanie innym.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {grupy.map((g) => (
        <div class="bg-white rounded-2xl overflow-hidden card-brutal-static flex flex-col">
          <div class="bg-[#1a2744]">
            <InfoMedia name={g.media.name} alt={g.media.alt} video sizes="(min-width: 768px) 560px, 92vw" />
          </div>
          <div class="p-6 md:p-8 flex flex-col flex-1">
            <h3 class="text-xl md:text-2xl font-bold text-primary mb-2">{g.title}</h3>
            <p class="text-gray-600 mb-5">{g.lead}</p>
            <ul class="space-y-3 text-sm text-gray-700 flex-1">
              {g.points.map((p) => (
                <li class="flex gap-2.5"><span class="text-accent shrink-0" aria-hidden="true">✓</span><span>{p}</span></li>
              ))}
            </ul>
            <p class="mt-6 pt-4 border-t border-gray-200 text-sm text-gray-500">{g.plan}</p>
          </div>
        </div>
      ))}
    </div>

    {showMore && (
      <p class="text-center mt-10">
        <a href="/integrator" class="inline-flex items-center gap-2 font-semibold text-accent hover:underline">
          Dowiedz się więcej o Integratorze
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </p>
    )}
  </div>
</section>
