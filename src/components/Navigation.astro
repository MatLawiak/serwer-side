---
const currentPath = Astro.url.pathname;

const PANEL_URL = 'https://integrator.serwer-side.pl';

const links = [
  { href: '/', label: 'Strona główna' },
  { href: '/integrator', label: 'Integrator' },
  { href: '/uslugi/infrastruktura-premium/', label: 'Usługi Premium (VPS)' },
  { href: '/wiedza', label: 'Wiedza' },
  { href: '/o-mnie', label: 'O mnie' },
  { href: '/kontakt', label: 'Kontakt' },
];

// Adresy stron mają ukośnik na końcu, a część linków go nie ma.
const bez = (s: string) => (s.length > 1 ? s.replace(/\/$/, '') : s);
const aktywny = (href: string) =>
  bez(currentPath) === bez(href) || (href !== '/' && currentPath.startsWith(bez(href) + '/'));
---

<div id="nav-sentinel" class="absolute top-0 h-[50px] w-full pointer-events-none" aria-hidden="true"></div>

<nav id="main-nav" class="bg-primary text-white sticky top-0 z-50 transition-all duration-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2" id="nav-logo">
        <img src="/logo-server-side.png" alt="serwer-side.pl" class="h-10 w-auto" />
        <div class="hidden md:flex flex-col leading-tight">
          <span class="font-bold text-lg leading-none">serwer-side.pl</span>
          <span class="text-xs text-gray-400 font-normal leading-none">Ekspert server-side tracking</span>
        </div>
      </a>

      {/* Desktop navigation */}
      <div class="hidden lg:flex items-center gap-5 xl:gap-6">
        {links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'nav-link text-sm font-medium transition-colors hover:text-accent whitespace-nowrap',
              aktywny(link.href) ? 'text-accent' : 'text-gray-300',
            ]}
          >
            {link.label}
          </a>
        ))}
        <a
          href={PANEL_URL}
          class="text-sm font-semibold px-4 py-2 rounded-lg border-2 border-accent/60 text-accent hover:bg-accent hover:text-white transition-colors"
        >
          Zaloguj
        </a>
      </div>

      {/* Mobile hamburger */}
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 rounded-md hover:bg-white/10 transition-colors"
        aria-label="Otwórz menu"
        aria-expanded="false"
      >
        <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

</nav>

{/* Mobile menu — full-screen overlay, niezależny od koloru navu */}
<div
  id="mobile-menu"
  class="fixed inset-0 top-16 z-40 hidden lg:hidden bg-[#1a2744]/97 backdrop-blur-md"
>
  <div class="px-6 py-8 space-y-1">
    {links.map((link) => (
      <a
        href={link.href}
        class:list={[
          'block px-3 py-4 rounded-md text-base font-medium transition-colors hover:text-accent border-b border-white/10',
          aktywny(link.href) ? 'text-accent' : 'text-white',
        ]}
      >
        {link.label}
      </a>
    ))}
    <a
      href={PANEL_URL}
      class="block mt-6 text-center px-3 py-3 rounded-lg border-2 border-accent/60 text-accent font-semibold"
    >
      Zaloguj się do Integratora
    </a>
  </div>
</div>

<script>
  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
    btn.setAttribute('aria-expanded', String(isOpen));
    // Blokuj scroll strony gdy menu otwarte
    document.body.classList.toggle('overflow-hidden', isOpen);
  });

  // Zamknij menu przy kliknięciu w link
  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('overflow-hidden');
    });
  });

  // Nav scroll effect
  const nav = document.getElementById('main-nav');
  const navSentinel = document.getElementById('nav-sentinel');
  const logo = document.getElementById('nav-logo');

  if (nav && navSentinel) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const scrolled = !entry.isIntersecting;
          nav.classList.toggle('bg-white/95', scrolled);
          nav.classList.toggle('backdrop-blur-sm', scrolled);
          nav.classList.toggle('border-b-2', scrolled);
          nav.classList.toggle('border-primary/10', scrolled);
          nav.classList.toggle('bg-primary', !scrolled);

          const logoText = logo?.querySelector('span');
          if (logoText) logoText.classList.toggle('text-primary', scrolled);

          nav.querySelectorAll('.nav-link:not(.text-accent)').forEach((a) => {
            a.classList.toggle('text-gray-600', scrolled);
            a.classList.toggle('text-gray-300', !scrolled);
          });
        });
      },
      { threshold: 0 }
    );
    observer.observe(navSentinel);
  }
</script>
