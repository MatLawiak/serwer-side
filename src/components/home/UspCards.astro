---
// Trzy wyróżniki Integratora. Etykieta stanu przy każdym jest obowiązkowa:
// strona trafia do weryfikatorów Meta i Google, którzy porównują obietnice
// z nagraniem, a funkcje zapisu są wyłączone do zatwierdzenia uprawnień.
const usps = [
  {
    badge: 'Sprawdzak: w przygotowaniu',
    badgeTone: 'soon',
    title: 'Zero narzucanych „ulepszeń” Meta i Google',
    desc: 'Advantage+ creative, automatyczne zasoby Google, rozszerzony targeting: platformy włączają to po cichu, a Ty płacisz za reklamę, której nie zatwierdziłeś. Integrator sprawdzi ustawienia każdej kampanii i ostrzeże, gdy coś zmieniło się bez Ciebie.',
    detail: 'Automatyczne wyłączanie: po zatwierdzeniu uprawnień zapisu przez Meta i Google.',
    icon: 'shield',
  },
  {
    badge: 'Działa dziś',
    badgeTone: 'now',
    title: 'Pełna swoboda kreacji',
    desc: 'Twoje grafiki, Twoje teksty, Twoje struktury kampanii. Integrator niczego nie podmienia. Pokazuje za to, która z Twoich kreacji przyniosła klientów, z którymi handlowiec chciał rozmawiać, a która tylko tanie kontakty.',
    detail: 'Szkic nowej kampanii z polecenia dla AI (zawsze wstrzymany): po zatwierdzeniu przez Meta i Google.',
    icon: 'palette',
  },
  {
    badge: 'Claude Desktop i Claude Code',
    badgeTone: 'now',
    title: 'Sterowanie przez MCP i czat',
    desc: 'Podłączasz Integrator do Claude jednym kluczem. Pytasz po polsku o wyniki, sygnały i kreacje klienta, bez otwierania Menedżera reklam. Każda liczba w odpowiedzi pochodzi z Twoich danych.',
    detail: 'Zmiany budżetu (najwyżej +20% w 24 h) i wstrzymanie kampanii: po zatwierdzeniu przez Meta i Google. ChatGPT: wkrótce.',
    icon: 'chat',
  },
];

const icons: Record<string, string> = {
  shield: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  palette: 'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01',
  chat: 'M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z',
};
---

<section class="py-16 md:py-20 bg-primary text-white border-t border-white/10">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-12">
      <span class="text-xs font-bold text-accent uppercase tracking-wider">Dlaczego Integrator</span>
      <h2 class="text-2xl md:text-3xl font-bold mt-3 mb-3">Kontrola wraca do Ciebie</h2>
      <p class="text-gray-400 max-w-2xl mx-auto">
        Platformy reklamowe optymalizują pod własne cele. Integrator stoi po stronie agencji: pokazuje, co naprawdę działa, i pilnuje, żeby nic nie zmieniło się bez Twojej wiedzy.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-5" id="usp-grid">
      {usps.map((u, i) => (
        <div
          class="usp-card bg-white/5 border border-white/10 rounded-2xl p-6 md:p-7 flex flex-col gap-4 opacity-0 translate-y-4 transition-all duration-500"
          style={`transition-delay: ${i * 120}ms`}
        >
          <div class="flex items-start justify-between gap-3">
            <div class="w-11 h-11 rounded-xl bg-accent/15 border border-accent/30 flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={icons[u.icon]} />
              </svg>
            </div>
            <span class:list={[
              'text-[11px] font-semibold px-2.5 py-1 rounded-full border whitespace-nowrap',
              u.badgeTone === 'now' ? 'border-emerald-400/40 text-emerald-300 bg-emerald-400/10' : 'border-amber-400/40 text-amber-300 bg-amber-400/10',
            ]}>{u.badge}</span>
          </div>
          <h3 class="text-lg font-bold leading-snug">{u.title}</h3>
          <p class="text-sm text-gray-300 leading-relaxed flex-grow">{u.desc}</p>
          <p class="text-xs text-gray-400 border-t border-white/10 pt-3">{u.detail}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const grid = document.getElementById('usp-grid');
  if (grid) {
    const cards = grid.querySelectorAll<HTMLElement>('.usp-card');
    const observer = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        cards.forEach((card) => card.classList.remove('opacity-0', 'translate-y-4'));
        observer.disconnect();
      }
    }, { threshold: 0.1 });
    observer.observe(grid);
  }
</script>
