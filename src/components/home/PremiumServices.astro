---
// Usługi wdrożeniowe jako uzupełnienie Integratora. Ceny są te same, co na
// podstronach usług; audyt obejmuje ręczne sprawdzenie ustawień Meta/Google,
// czyli to, co „sprawdzak” w panelu zrobi dopiero w przyszłości.
// `only` zawęża listę (na /uslugi Power Upy mają już własne karty wyżej).
interface Props {
  only?: string[];
  heading?: string;
  intro?: string;
}
const {
  only,
  heading = 'Wdrożenia, które karmią Integrator pełnymi danymi',
  intro = 'Jednorazowa praca na Twojej infrastrukturze. Bez abonamentów za narzędzia, z pełną własnością danych.',
} = Astro.props;

const wszystkie = [
  {
    id: 'meta',
    name: 'Meta Power Up',
    price: 'od 800 zł',
    note: '+ serwer 25–50 zł/mies.',
    desc: 'Conversions API z deduplikacją, Enhanced Matching i first-party cookies na Twojej subdomenie. Raport EMQ po wdrożeniu.',
    href: '/uslugi/meta-power-vps',
  },
  {
    id: 'google',
    name: 'Google Power Up',
    price: 'od 1 000 zł',
    note: 'Tag Gateway · sGTM od 2 200 zł',
    desc: 'GA4 i Google Ads server-side. Tag Gateway na Cloudflare dla mniejszych budżetów, pełen sGTM na VPS powyżej 50 tys. zł miesięcznie.',
    href: '/uslugi/google-power-vps',
  },
  {
    id: 'vps',
    name: 'Dedykowany VPS pod tracking',
    price: '25–130 zł/mies.',
    note: 'Hostinger, centra danych w EOG',
    desc: 'Twój własny serwer: dane nie mieszają się z innymi klientami, a wydajność nie zależy od cudzego ruchu. Konfiguracja w cenie wdrożenia.',
    href: '/uslugi/automatyzacje-vps',
  },
  {
    id: 'audyt',
    name: 'Audyt kont i ustawień Meta/Google',
    price: '2 000–4 000 zł',
    note: '3–5 dni roboczych',
    desc: 'Sprawdzamy piksel, CAPI, GA4, GTM i ustawienia kampanii: co platforma włączyła za Ciebie, gdzie gubisz dane i co naprawić najpierw. Koszt odliczamy od wdrożenia.',
    href: '/kontakt?usluga=audyt',
  },
];
const uslugi = only ? wszystkie.filter((u) => only.includes(u.id)) : wszystkie;
const kolumny = uslugi.length >= 4 ? 'lg:grid-cols-4' : uslugi.length === 3 ? 'lg:grid-cols-3' : 'lg:grid-cols-2 max-w-4xl mx-auto';
---

<section class="py-16 md:py-20 bg-stone-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-12">
      <span class="text-xs font-bold text-accent uppercase tracking-wider">Usługi premium</span>
      <h2 class="text-2xl md:text-3xl font-bold mt-3 mb-3">{heading}</h2>
      <p class="text-gray-600 max-w-2xl mx-auto">{intro}</p>
    </div>
    <div class:list={['grid sm:grid-cols-2 gap-5', kolumny]}>
      {uslugi.map((u) => (
        <a href={u.href} class="group bg-white rounded-xl p-6 card-brutal flex flex-col">
          <h3 class="text-lg font-bold mb-1 group-hover:text-accent transition-colors">{u.name}</h3>
          <p class="text-accent font-extrabold text-2xl">{u.price}</p>
          <p class="text-gray-500 text-xs mb-4">{u.note}</p>
          <p class="text-gray-600 text-sm leading-relaxed flex-grow">{u.desc}</p>
          <span class="mt-5 text-accent font-semibold text-sm">Szczegóły →</span>
        </a>
      ))}
    </div>
  </div>
</section>
