---
// „Jak to działa”: pętla Remotion (2026-11-26) ze schematem źródła →
// Integrator → wyjścia. Na telefonie grafika byłaby nieczytelna, więc od `md`
// w górę stoi film, a dwie kolumny tekstu są wszędzie. Komponent jest też na
// stronie głównej (src/pages/index.astro).
import InfoMedia from '../integrator/InfoMedia.astro';

const zrodla = [
  { name: 'Meta Ads', desc: 'kampanie, reklamy, wydatki' },
  { name: 'Google Ads', desc: 'kampanie, reklamy, słowa kluczowe' },
  { name: 'Arkusz albo CRM', desc: 'oceny zgłoszeń, opcjonalnie' },
];
const wyjscia = [
  { name: 'Raport co rano', desc: 'na e-mail albo Slacka' },
  { name: 'Podpowiedzi', desc: 'z wyników Twoich kampanii' },
  { name: 'Polecenia w czacie AI', desc: 'w Claude albo ChatGPT' },
];
---

<section class="py-16 md:py-20 bg-primary text-white" id="integrator-flow-section">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-10">
      <span class="text-xs font-bold text-accent uppercase tracking-wider">Jak to działa</span>
      <h2 class="text-2xl md:text-3xl font-bold mt-3 mb-3">Twórz, poprawiaj, mierz. Bez przeklikiwania Menedżerów reklam.</h2>
      <p class="text-gray-400 max-w-3xl mx-auto">
        Integrator zbiera dane z Meta Ads, Google Ads i Twojego arkusza albo CRM. Wyniki dostajesz w raporcie, w podpowiedziach i w rozmowie z AI. Kampanie tworzysz i poprawiasz poleceniem, a konwersje ustawiasz bez grzebania w kontenerze GTM.
      </p>
    </div>

    <div class="hidden md:block max-w-5xl mx-auto rounded-2xl overflow-hidden card-brutal-static bg-[#1a2744]">
      <InfoMedia
        name="01-jak-to-dziala"
        video
        width={1600}
        height={800}
        alt="Schemat: dane z Meta Ads, Google Ads i arkusza płyną do Integratora, a z niego do raportu e-mail, podpowiedzi i czatu AI"
      />
    </div>

    <div class="grid sm:grid-cols-2 gap-6 max-w-5xl mx-auto mt-8">
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-gray-400 mb-3">Skąd bierze dane</h3>
        <ul class="space-y-2">
          {zrodla.map((z) => (
            <li class="bg-white/5 border border-white/10 rounded-xl px-4 py-3">
              <p class="font-semibold">{z.name}</p>
              <p class="text-xs text-gray-400">{z.desc}</p>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-gray-400 mb-3">Co dostajesz</h3>
        <ul class="space-y-2">
          {wyjscia.map((w) => (
            <li class="bg-white/5 border border-white/10 rounded-xl px-4 py-3">
              <p class="font-semibold text-accent">{w.name}</p>
              <p class="text-xs text-gray-400">{w.desc}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <p class="text-center text-sm text-gray-500 mt-8 max-w-xl mx-auto">
      Podłączenie to kilka kliknięć: logujesz się przez Facebook i Google i zaznaczasz konta, które Integrator ma czytać.
    </p>
  </div>
</section>
