---
// Server-side tracking jako fundament danych Integratora i dwie ścieżki
// wdrożeniowe. Sekcja w idiomie BarriersSection (ciemne karty, wejście
// przy przewinięciu). Używana na stronie głównej i na /uslugi.
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;

const sciezki = [
  {
    tag: 'Lead Gen',
    title: 'Deweloperzy, usługi, B2B',
    intro: 'Lead to dopiero początek. Liczy się, czy handlowiec miał z kim rozmawiać.',
    points: [
      'Leady z formularzy Meta, Google i strony www z identyfikatorem reklamy',
      'Ocena handlowca z CRM (np. voxDeveloper) albo z arkusza Google',
      'CPQL: koszt zakwalifikowanego leada dla każdej kreacji i kampanii',
      'Oceny wracają do Meta (Conversions API), algorytm uczy się na dobrych klientach',
    ],
    href: '/integrator',
    cta: 'Zobacz Integrator',
  },
  {
    tag: 'E-commerce',
    title: 'Sklepy internetowe',
    intro: 'Adblockery i iOS gubią zakupy. Algorytm optymalizuje pod połowę prawdy.',
    points: [
      'Pełne Conversions API Meta i Google po stronie serwera (Meta i Google Power Up)',
      'Odzyskanie zdarzeń blokowanych w przeglądarce, deduplikacja z pikselem',
      'Wartość koszyka i realny ROAS w raportach platform',
      'W Integratorze: koszt każdej konwersji po nazwie zdarzenia, Meta obok Google',
    ],
    href: '/uslugi/meta-power-vps',
    cta: 'Zobacz Meta Power Up',
  },
];
---

<section class:list={['bg-primary text-white', compact ? 'py-14' : 'py-16 md:py-20 border-t border-white/10']}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-12">
      <span class="text-xs font-bold text-accent uppercase tracking-wider">Fundament danych</span>
      <h2 class="text-2xl md:text-3xl font-bold mt-3 mb-3">Integrator liczy tylko tak dobrze, jak dobre dane dostaje</h2>
      <p class="text-gray-400 max-w-2xl mx-auto">
        Server-side tracking na Twoim serwerze sprawia, że Meta i Google widzą pełne konwersje, a Integrator pracuje na kompletnych danych. Dwie ścieżki, zależnie od tego, co sprzedajesz.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-5" id="paths-grid">
      {sciezki.map((s, i) => (
        <div
          class="path-card bg-white/5 border border-white/10 rounded-2xl p-6 md:p-7 flex flex-col opacity-0 translate-y-4 transition-all duration-500"
          style={`transition-delay: ${i * 120}ms`}
        >
          <span class="inline-block self-start text-xs font-bold text-accent uppercase tracking-wider mb-2">{s.tag}</span>
          <h3 class="text-xl font-bold mb-1">{s.title}</h3>
          <p class="text-sm text-gray-400 mb-5">{s.intro}</p>
          <ul class="space-y-2.5 text-sm text-gray-200 flex-grow">
            {s.points.map((p) => (
              <li class="flex items-start gap-2"><span class="text-accent mt-0.5">✓</span><span>{p}</span></li>
            ))}
          </ul>
          <a href={s.href} class="mt-6 inline-flex items-center gap-2 text-accent font-semibold text-sm hover:underline">{s.cta} →</a>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const grid = document.getElementById('paths-grid');
  if (grid) {
    const cards = grid.querySelectorAll<HTMLElement>('.path-card');
    const observer = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        cards.forEach((card) => card.classList.remove('opacity-0', 'translate-y-4'));
        observer.disconnect();
      }
    }, { threshold: 0.1 });
    observer.observe(grid);
  }
</script>
