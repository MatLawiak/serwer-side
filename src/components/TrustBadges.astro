---
interface Props {
  variant?: 'light' | 'dark';
  delay?: string;
}

const { variant = 'dark', delay = '0s' } = Astro.props;
const textColor = variant === 'light' ? 'text-gray-300/80' : 'text-slate-500';

const badges = [
  { icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z', text: 'Gwarancja mierzalnych wyników' },
  { icon: 'M9 19v-6m4 6V5m4 14v-9M5 19h14', text: 'Raport przed vs po w cenie' },
  { icon: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z', text: 'Zgodność z RODO' },
  { icon: 'M13 10V3L4 14h7v7l9-11h-7z', text: 'Wdrożenie w 14 dni' },
];
---

<div
  class:list={[
    'flex flex-wrap justify-center gap-x-6 gap-y-3',
    textColor,
    delay !== '0s' && 'animate-fade-in-up',
  ]}
  style={delay !== '0s' ? `animation-delay: ${delay}` : undefined}
>
  {badges.map((badge) => (
    <span class="flex items-center gap-1.5 text-sm">
      <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={badge.icon} /></svg>
      <span>{badge.text}</span>
    </span>
  ))}
</div>
